<?xml version="1.0" encoding="utf-8"?>
<!-- Auth tokens live in shared preferences (encrypted with a Keystore key).
     Nothing here should leave the device via backup or transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
